# Silence Map Environment Variables (Example)

# PyAnnote / Hugging Face Token for production neural diarization pipeline
# Required only if running live diarization on the backend with pyannote.audio
HF_TOKEN=hf_your_token_here

# Allowed origins for CORS (comma-separated, or * for open development)
CORS_ORIGINS=http://localhost:5173,https://silencemap.vercel.app

# Custom temporary directory for audio uploads
# Default: System temporary directory (e.g., /tmp or OS temp folder)
# UPLOAD_DIR=/tmp/silence_map_uploads

# Backend server port (default: 8000)
PORT=8000
