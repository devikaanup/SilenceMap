# FastAPI Backend Configuration

# Hugging Face User Access Token (read permissions for pyannote/speaker-diarization-3.1)
HF_TOKEN=hf_your_token_here

# Allowed origins for CORS (comma-separated, e.g. http://localhost:5173,https://silencemap.vercel.app)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Temporary directory for uploaded audio files before processing
# UPLOAD_DIR=/tmp/silence_map_uploads

# Server Port
PORT=8000
